:: StoryStylesheet [stylesheet]
/* ═══════════════════════════════════════════════════
   CRÓNICAS DEL CAMPUS — Estilo Zork Retro
   Paleta: Terminal Verde + Fondos Dinámicos
   Técnica: Glassmorphism Retro (Blurry Cards)
   ═══════════════════════════════════════════════════ */

/* ——— Google Fonts ——— */
@import url('https://fonts.googleapis.com/css2?family=VT323&display=swap');

/* ——— Reset & Base ——— */
html, body {
  margin: 0;
  padding: 0;
  height: 100%;
  overflow-x: hidden;
  background-color: #000;
}

body {
  color: #4af626; /* Verde Fósforo / Zork */
  font-family: 'VT323', monospace;
  font-size: 1.4rem;
  line-height: 1.6;
}

/* ——— Fondos dinámicos según lo que está pasando ——— */
body {
  background-size: cover;
  background-position: center;
  background-attachment: fixed;
  background-repeat: no-repeat;
  transition: background-image 0.5s ease-in-out;
}

/* Fondo por defecto / Noche de estudio */
body {
  background-image: url('primera-escena.png');
  background-size: 100%; 
  background-repeat: no-repeat;
  background-position: center;
}

/* 1. Pasaje Inicial: El Laberinto del Reloj */
body[data-passagename="El Laberinto del Reloj: ¿Estudiar o Procrastinar?"] {
  /* Reemplazar con URL de imagen para el inicio */
  background-image: url('primera-escena.png');
  background-size: 100%; 
}

/* 2. Pasaje: Estudio_Limpio */
body[data-passagename="Estudio_Limpio"] {
  /* Reemplazar con URL de imagen para: Leer los apuntes y empezar ejercicios */
  background-image: url('segunda-escena.png');
}

/* 3. Pasaje: Distraccion_Redes */
body[data-passagename="Distraccion_Redes"] {
  /* Reemplazar con URL de imagen para: Revisar el celular */
  background-image: url('decimoprimera-escena.png');
  background-size: 75%;
}

/* 4. Pasaje: Cocina_SpeedMax */
body[data-passagename="Cocina_SpeedMax"] {
  /* Reemplazar con URL de imagen para: Ir a la cocina por cafeína */
  background-image: url('decimoquinta-escena.png');
}

/* 5. Pasaje: Consejo_Sofia */
body[data-passagename="Consejo_Sofia"] {
  /* Reemplazar con URL de imagen para: Pedir consejo a Sofía */
  background-image: url('decimosexta-escena.png');
}

/* 6. Pasaje: Huir_Cuarto */
body[data-passagename="Huir_Cuarto"] {
  /* Reemplazar con URL de imagen para: Huir a tu cuarto tras ver a Sofía */
  background-image: url('decimooctava-escena.png');
}

/* 7. Pasaje: Plan_Sofia */
